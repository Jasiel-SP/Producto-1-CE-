
==============================================================================
 R2
==============================================================================
 
enable
configure terminal
ipv6 unicast-routing
 
! e0/0 -> SWA13
interface e0/0
 duplex full
 no shutdown
 exit
 
interface e0/0.50
 encapsulation dot1Q 50
 ip address 172.22.10.2 255.255.255.128
 ipv6 address 2001:25:22:6::2/64
 standby 50 ip 172.22.10.1
 standby 50 priority 110
 standby 50 preempt
 exit
 
interface e0/0.60
 encapsulation dot1Q 60
 ip address 172.22.10.130 255.255.255.128
 ipv6 address 2001:25:22:7::2/64
 standby 60 ip 172.22.10.129
 standby 60 priority 110
 standby 60 preempt
 exit
 
interface e0/0.88
 encapsulation dot1Q 88
 ip address 172.22.11.66 255.255.255.240
 ipv6 address 2001:25:22:9::2/64
 standby 88 ip 172.22.11.65
 standby 88 priority 110
 standby 88 preempt
 exit
 
! e0/1 -> SW (Datacenter)
interface e0/1
 duplex full
 no shutdown
 exit
 
interface e0/1.70
 encapsulation dot1Q 70
 ip address 172.22.11.2 255.255.255.192
 ipv6 address 2001:25:22:8::2/64
 standby 70 ip 172.22.11.1
 standby 70 priority 110
 standby 70 preempt
