! s1/0 -> R1-CORE
interface s1/0
 ip address 172.22.11.82 255.255.255.252
 ipv6 address 2001:25:22:a::2/64
 no shutdown
 exit
 
router ospf 1
 router-id 2.2.2.2
 network 172.22.10.0 0.0.0.127 area 0
 network 172.22.10.128 0.0.0.127 area 0
 network 172.22.11.0 0.0.0.63 area 0
 network 172.22.11.64 0.0.0.15 area 0
 network 172.22.11.80 0.0.0.3 area 0
 exit
 
end
