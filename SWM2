
==============================================================================
 SWM2  (VTP client + STP root secondary)
==============================================================================
 
enable
configure terminal
 
vtp domain ITLA
vtp mode client
 
spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,30,40,50,60,70,88,99 root secondary
 
! EtherChannel hacia SWM1
interface range e0/1 - 3
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-group 1 mode active
 no shutdown
 exit
 
interface port-channel 1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 exit
 
! e0/0 -> R1-CORE | e1/0 -> SWAC1 | e1/1 -> SWAC2 | e1/2 -> SWAC3
interface range e0/0, e1/0, e1/1, e1/2
 switchport trunk encapsulation dot1q
 switchport mode trunk
 no shutdown
 exit
 
end
write memory
 
 
==============================================================================
 SWAC1  (acceso Docentes - DOC1)
==============================================================================
 
enable
configure terminal
vtp domain ITLA
vtp mode client
 
interface range e0/0 - 1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 no shutdown
 exit
 
interface e1/0
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
 exit
 
end
write memory
 
