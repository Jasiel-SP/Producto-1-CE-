
==============================================================================
 SW  (Datacenter - SERVICIOS)
==============================================================================
 
enable
configure terminal
vlan 70
 name Datacenter
exit
 
! e0/0 -> R2 e0/1
interface e0/0
 switchport trunk encapsulation dot1q
 switchport mode trunk
 no shutdown
 exit
 
! e0/1 -> SERVICIOS
interface e0/1
 switchport mode access
 switchport access vlan 70
 spanning-tree portfast
 no shutdown
 exit
 
end
write memory
 
