
==============================================================================
 SWM1  (VTP server + STP root primary)
==============================================================================
 
enable
configure terminal
 
vtp domain ITLA
vtp mode server
vtp version 2
 
vlan 10
 name Estudiantes
vlan 20
 name Docentes
vlan 30
 name Gestion
vlan 40
 name Voz
vlan 50
 name Academicos
vlan 60
 name Finanzas
vlan 70
 name Datacenter
vlan 88
 name Blackhull_R2
vlan 99
 name Blackhull_R1
exit
 
spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,30,40,50,60,70,88,99 root primary
 
! EtherChannel hacia SWM2
interface range e0/1 - 3
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-group 1 mode active
 no shutdown
 exit
 
interface port-channel 1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 exit
 
! e0/0 -> R1-CORE | e1/0 -> SWAC1 | e1/1 -> SWAC2 | e1/2 -> SWAC3
interface range e0/0, e1/0, e1/1, e1/2
 switchport trunk encapsulation dot1q
 switchport mode trunk
 no shutdown
 exit
 
end
write memo
